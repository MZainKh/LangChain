    {
      "id": "v60_single_cup",
      "name": "Hario V60 (Single Cup)",
      "aliases": ["v60", "v60 pour over"],
      "method_type": "pour_over",
      "difficulty": 3,
      "yield": {
        "beverage_ml": 250,
        "concentrate": false
      },
      "targets": {
        "ratio_coffee_g_per_water_ml": 0.06,
