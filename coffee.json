      "grind": {
        "level_1_to_10": 5,
        "descriptor": "medium-fine"
      },
      "water": {
        "temperature_c": 94
      },
      "equipment": [
        "Hario V60 dripper",
        "V60 paper filter",
        "gooseneck kettle",
        "scale",
        "timer"
      ],
      "phases": [
        {
          "phase": "prep",
          "actions": [
            {
              "action": "rinse_filter",
              "notes": "Rinse filter with hot water; discard rinse water; preheat vessel."
            }
          ]
        },
        {
          "phase": "dose",
          "actions": [
            {
              "action": "add_coffee",
              "parameters": { "coffee_g": 15 },
              "notes": "Level the bed; create small divot if desired."
            }
          ]
        },
        {
          "phase": "bloom",
          "actions": [
            {
              "action": "pour",
              "parameters": { "water_ml": 45, "pour_time_s": 10 },
              "notes": "Saturate all grounds evenly."
            },
            {
              "action": "wait",
              "parameters": { "time_s": 35 }
            }
          ],
          "metrics": {
            "expected_scale_reading_ml": 45
          }
        },
        {
          "phase": "main_pours",
          "actions": [
            {
              "action": "pulse_pours",
              "parameters": {
                "pulses": 3,
                "each_pulse_ml": 68,
                "pour_time_s_each": 12,
                "pause_s_between": 15
              },
              "notes": "Maintain slurry level; pour in slow spirals; avoid heavy edge-channeling."
            }
          ],
          "metrics": {
            "expected_total_water_ml": 249
          }
        },
        {
          "phase": "drawdown",
          "actions": [
            {
              "action": "wait_until_drawdown_complete",
              "parameters": { "max_time_s": 210 },
              "notes": "Target bed should look flat; no large side-wall bypass."
            }
          ]
        }
      ],
      "sensory_tags": ["clean", "bright", "transparent", "high_aroma"],
      "tuning_guide": {
        "too_sour_underextracted": [
          "grind finer by 0.5-1 level",
          "increase water temperature +1-2C",
          "extend brew time by slowing pours"
        ],
        "too_bitter_overextracted": [
          "grind coarser by 0.5-1 level",
          "lower water temperature -1-2C",
          "reduce agitation; avoid aggressive swirling"
        ],
        "too_weak": ["increase coffee dose (e.g., 16g) or reduce water to 230ml"],
        "too_strong": ["reduce dose or increase water slightly"]
      }
    },
